    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-day-picker": "9.6.3",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.55.0",
    "react-resizable-panels": "^2.1.7",
    "react-virtualized-auto-sizer": "^2.0.2",
    "react-virtuoso": "^4.18.1",
    "react-window": "^2.2.5",
    "recharts": "^2.15.1",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.8.2",
    "vaul": "^1.1.2",
