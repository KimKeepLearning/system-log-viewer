{
  "name": "system-log-viewer",
  "version": "1.0.0",
  "description": "View chrome system logs easily",
  "license": "MIT",
  "main": "./dist-electron/main/index.js",
  "author": "yennefer@vibe.us",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-forge start",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "ui-add": "pnpm dlx shadcn@latest add",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:win": "pnpm run build && electron-forge make --platform=win32 --arch=x64",
    "make:mac": "pnpm run build && electron-forge make --platform=darwin --arch=x64",
    "make:mac:arm": "pnpm run build && electron-forge make --platform=darwin --arch=arm64",
    "publish": "electron-forge publish",
    "publish:all": "pnpm run publish:win && pnpm run publish:mac && pnpm run publish:linux",
    "publish:win": "pnpm run build && electron-forge publish --platform=win32 --arch=x64",
    "publish:mac": "pnpm run build && electron-forge publish --platform=darwin --arch=x64",
    "publish:linux": "electron-forge publish --platform=linux --arch=x64"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.5.16",
    "debug": "^4.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "update-electron-app": "^3.1.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/publisher-github": "^7.11.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
